{
  "name": "japanese-reader",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "dev:backend": "uv run uvicorn backend.app.main:app --reload --reload-dir backend --host 127.0.0.1 --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "uv run pytest && npm --prefix frontend test -- --run",
    "test:backend": "uv run pytest",
    "test:frontend": "npm --prefix frontend test -- --run",
    "build": "npm --prefix frontend run build"
  }
}
